@{
    ViewData["Title"] = "AutoMerge Tool";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
        background: #f6f8fa;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .editor-box {
        margin-bottom: 20px;
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        overflow: hidden;
    }

    .editor-header {
        background: #f6f8fa;
        padding: 8px 12px;
        border-bottom: 1px solid #d0d7de;
        font-weight: 600;
        font-size: 14px;
        color: #24292f;
    }

    .code-wrapper {
        display: flex;
        height: 250px;
    }

    /* Номера строк */
    .line-numbers {
        width: 40px;
        background: #f6f8fa;
        border-right: 1px solid #d0d7de;
        color: #6e7781;
        text-align: right;
        padding: 10px 8px;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 13px;
        line-height: 1.5;
        user-select: none;
        overflow: hidden;
    }

    /* Подсветка конфликтных номеров строк */
    .conflict-line-number {
        background: #ffebe9 !important;
        color: #cf222e !important;
        font-weight: bold;
        cursor: pointer;
        position: relative;
    }

        .conflict-line-number:hover::after {
            content: '+';
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            background: #cf222e;
            color: white;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            font-size: 12px;
            line-height: 16px;
            text-align: center;
            z-index: 10;
        }

    textarea {
        flex: 1;
        border: none;
        resize: none;
        padding: 10px;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 13px;
        line-height: 1.5;
        outline: none;
        white-space: pre;
        overflow-wrap: normal;
        overflow-x: auto;
    }

    .row {
        display: flex;
        gap: 20px;
    }

    .col {
        flex: 1;
    }

    .btn-merge {
        display: block;
        width: 100%;
        padding: 12px;
        background: #2da44e;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        margin-bottom: 20px;
        transition: background 0.2s;
    }

        .btn-merge:hover {
            background: #2c974b;
        }

    .btn-resolve {
        padding: 6px 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        margin-right: 8px;
        transition: opacity 0.2s;
    }

        .btn-resolve:hover {
            opacity: 0.8;
        }

    .btn-v1 {
        background: #0969da;
        color: white;
    }

    .btn-v2 {
        background: #8250df;
        color: white;
    }

    /* Панель конфликтов */
    .conflict-panel {
        margin-top: 20px;
        padding: 16px;
        background: #fff8c5;
        border: 1px solid #d4a72c;
        border-radius: 6px;
    }

    .conflict-card {
        margin-bottom: 16px;
        padding: 12px;
        background: white;
        border: 1px solid #d0d7de;
        border-radius: 6px;
    }

        .conflict-card.resolved {
            opacity: 0.5;
            border-color: #3fb950;
            background: #f0fff4;
        }

    .conflict-header {
        font-weight: 600;
        margin-bottom: 8px;
        color: #cf222e;
    }

    .conflict-text {
        font-family: 'Consolas', monospace;
        font-size: 12px;
        background: #f6f8fa;
        padding: 8px;
        border-radius: 4px;
        margin: 8px 0;
        white-space: pre-wrap;
        word-break: break-all;
    }

    .conflict-lines {
        font-size: 12px;
        color: #6e7781;
        margin-bottom: 4px;
    }
</style>

<div class="container">
    <h2 style="text-align: center; margin-bottom: 30px;">🔀 AutoMerge Web</h2>

    <!-- Original -->
    <div class="editor-box">
        <div class="editor-header">📄 Исходный файл (Original)</div>
        <div class="code-wrapper">
            <div class="line-numbers" id="ln-orig">1</div>
            <textarea id="orig" placeholder="Вставьте исходный код сюда..."></textarea>
        </div>
    </div>

    <!-- V1 and V2 -->
    <div class="row">
        <div class="col editor-box">
            <div class="editor-header">👤 Версия 1 (Programmer 1)</div>
            <div class="code-wrapper">
                <div class="line-numbers" id="ln-v1">1</div>
                <textarea id="v1" placeholder="Изменения 1..."></textarea>
            </div>
        </div>
        <div class="col editor-box">
            <div class="editor-header"> Версия 2 (Programmer 2)</div>
            <div class="code-wrapper">
                <div class="line-numbers" id="ln-v2">1</div>
                <textarea id="v2" placeholder="Изменения 2..."></textarea>
            </div>
        </div>
    </div>

    <button class="btn-merge" onclick="performMerge()">⚡ Выполнить слияние (Merge)</button>

    <!-- Merged -->
    <div class="editor-box">
        <div class="editor-header">✅ Результат слияния (Merged)</div>
        <div class="code-wrapper" style="height: 350px;">
            <div class="line-numbers" id="ln-merged">1</div>
            <textarea id="merged" readonly style="background: #f6f8fa;"></textarea>
        </div>
    </div>

    <!-- Панель разрешения конфликтов -->
    <div id="conflictPanel" class="conflict-panel" style="display: none;">
        <h3 style="margin-top: 0; color: #9a6700;">⚠️ Неразрешённые конфликты</h3>
        <p style="font-size: 14px; color: #6e7781; margin-bottom: 16px;">
            Нажмите <strong>+</strong> на конфликтной строке или используйте кнопки ниже
        </p>
        <div id="conflictCards"></div>
    </div>
</div>

<script>
    // Глобальное состояние конфликтов
    let currentConflicts = [];
    let v1ConflictLines = [];
    let v2ConflictLines = [];

    // Обновление номеров строк с подсветкой конфликтов
    function updateLineNumbers(textareaId, lineNumId) {
        const textarea = document.getElementById(textareaId);
        const lineNums = document.getElementById(lineNumId);
        const lines = textarea.value.split('\n').length;

        // Определяем конфликтные строки для этого поля
        const conflictLines = textareaId === 'v1' ? v1ConflictLines :
                              textareaId === 'v2' ? v2ConflictLines : [];

        let html = '';
        for (let i = 1; i <= lines; i++) {
            const isConflict = conflictLines.includes(i);
            html += `<div class="${isConflict ? 'conflict-line-number' : ''}"
                         data-line="${i}"
                         ${isConflict ? `onclick="showResolveButton(${i}, '${textareaId}')"` : ''}>${i}</div>`;
        }
        lineNums.innerHTML = html;
    }

    // Показать кнопку "+" при клике на конфликтный номер строки
    function showResolveButton(lineNum, fieldId) {
        // Находим конфликт, содержащий эту строку
        const conflict = currentConflicts.find(c =>
            (fieldId === 'v1' && c.v1Lines.includes(lineNum)) ||
            (fieldId === 'v2' && c.v2Lines.includes(lineNum))
        );

        if (!conflict || conflict.resolved) return;

        // Прокручиваем к карточке конфликта
        const card = document.getElementById(`conflict-${conflict.id}`);
        if (card) {
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            card.style.boxShadow = '0 0 0 3px #cf222e';
            setTimeout(() => card.style.boxShadow = '', 2000);
        }
    }

    // Синхронизация скролла
    function syncScroll(textareaId, lineNumId) {
        const textarea = document.getElementById(textareaId);
        const lineNums = document.getElementById(lineNumId);
        textarea.addEventListener('scroll', () => { lineNums.scrollTop = textarea.scrollTop; });
    }

    // Инициализация полей
    ['orig', 'v1', 'v2', 'merged'].forEach(id => {
        const textarea = document.getElementById(id);
        textarea.addEventListener('input', () => updateLineNumbers(id, 'ln-' + id));
        syncScroll(id, 'ln-' + id);
    });

    // Автокопирование из orig
    document.getElementById('orig').addEventListener('input', function () {
        const v1 = document.getElementById('v1');
        const v2 = document.getElementById('v2');
        if (!v1.value.trim() && !v2.value.trim() && this.value.trim() !== '') {
            v1.value = this.value;
            v2.value = this.value;
            updateLineNumbers('v1', 'ln-v1');
            updateLineNumbers('v2', 'ln-v2');
        }
        updateLineNumbers('orig', 'ln-orig');
    });

    // Выполнение слияния
    async function performMerge() {
        const btn = document.querySelector('.btn-merge');
        btn.textContent = '⏳ Слияние...';
        btn.disabled = true;

        const payload = {
            original: document.getElementById('orig').value,
            version1: document.getElementById('v1').value,
            version2: document.getElementById('v2').value
        };

        try {
            const response = await fetch('/Merge/Merge', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await response.json();

            // Отображаем merged результат
            document.getElementById('merged').value = data.merged;
            updateLineNumbers('merged', 'ln-merged');

            // Сохраняем информацию о конфликтах
            currentConflicts = (data.conflicts || []).map(c => ({
                ...c,
                resolved: false
            }));

            // Обновляем список конфликтных строк для подсветки
            v1ConflictLines = currentConflicts.flatMap(c => c.v1LineNumbers);
            v2ConflictLines = currentConflicts.flatMap(c => c.v2LineNumbers);

            // Перерисовываем номера строк с подсветкой
            updateLineNumbers('v1', 'ln-v1');
            updateLineNumbers('v2', 'ln-v2');

            // Отображаем панель конфликтов
            renderConflictPanel();

        } catch (error) {
            alert('Ошибка при слиянии: ' + error);
        } finally {
            btn.textContent = '⚡ Выполнить слияние (Merge)';
            btn.disabled = false;
        }
    }

    // Рендеринг панели конфликтов
    function renderConflictPanel() {
        const panel = document.getElementById('conflictPanel');
        const cardsContainer = document.getElementById('conflictCards');

        const unresolved = currentConflicts.filter(c => !c.resolved);

        if (unresolved.length === 0) {
            panel.style.display = 'none';
            return;
        }

        panel.style.display = 'block';
        cardsContainer.innerHTML = '';

        unresolved.forEach(conflict => {
            const card = document.createElement('div');
            card.className = 'conflict-card';
            card.id = `conflict-${conflict.id}`;

            card.innerHTML = `
                <div class="conflict-header">Конфликт #${conflict.id + 1}</div>

                <div class="conflict-lines">👤 Версия 1 — строки ${conflict.v1LineNumbers.join(', ')}</div>
                <div class="conflict-text">${escapeHtml(conflict.v1Text)}</div>

                <div class="conflict-lines"> Версия 2 — строки ${conflict.v2LineNumbers.join(', ')}</div>
                <div class="conflict-text">${escapeHtml(conflict.v2Text)}</div>

                <div style="margin-top: 12px;">
                    <button class="btn-resolve btn-v1" onclick="resolveConflict(${conflict.id}, 'v1')">
                        ✓ Взять Версию 1
                    </button>
                    <button class="btn-resolve btn-v2" onclick="resolveConflict(${conflict.id}, 'v2')">
                        ✓ Взять Версию 2
                    </button>
                </div>
            `;

            cardsContainer.appendChild(card);
        });
    }

    // Разрешение конфликта
    function resolveConflict(conflictId, choice) {
        const conflict = currentConflicts.find(c => c.id === conflictId);
        if (!conflict || conflict.resolved) return;

        const mergedTextarea = document.getElementById('merged');
        let mergedText = mergedTextarea.value;

        // Формируем точный текст маркеров конфликта (как на сервере)
        const conflictMarker = `<<<<<<< Конфликт (версия 1)\n${conflict.v1Text}\n=======\n${conflict.v2Text}\n>>>>>>> Конфликт (версия 2)`;

        // Заменяем на выбранный вариант
        const replacement = choice === 'v1' ? conflict.v1Text : conflict.v2Text;

        if (mergedText.includes(conflictMarker)) {
            mergedText = mergedText.replace(conflictMarker, replacement);
            mergedTextarea.value = mergedText;

            // Помечаем конфликт как разрешённый
            conflict.resolved = true;

            // Обновляем номера строк в merged
            updateLineNumbers('merged', 'ln-merged');

            // Убираем подсветку разрешённых строк
            v1ConflictLines = currentConflicts
                .filter(c => !c.resolved)
                .flatMap(c => c.v1LineNumbers);
            v2ConflictLines = currentConflicts
                .filter(c => !c.resolved)
                .flatMap(c => c.v2LineNumbers);

            updateLineNumbers('v1', 'ln-v1');
            updateLineNumbers('v2', 'ln-v2');

            // Перерисовываем панель (убираем разрешённый конфликт)
            renderConflictPanel();

            // Если все конфликты разрешены — показываем успех
            if (currentConflicts.every(c => c.resolved)) {
                mergedTextarea.style.color = '#24292f';
                mergedTextarea.style.background = '#f0fff4';
            }
        }
    }

    // Экранирование HTML
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>